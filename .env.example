# Mia AI Environment Configuration (.env)

# Opencode-Go / Mimo-v2.5 Configuration
OPENCODE_GO_API_KEY=your_opencode_go_or_mimo_api_key_here
# Optional custom base URL if using an OpenAI-compatible proxy (defaults to https://api.opencode.ai/v1):
# OPENCODE_GO_BASE_URL=https://api.opencode.ai/v1

# Other Providers (Optional)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# Default Model Selection Override (e.g. mimo-v2.5, claude-3-5-sonnet, gpt-4o)
# MIA_MODEL=mimo-v2.5
